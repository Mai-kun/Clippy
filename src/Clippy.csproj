<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dual-targeting, decided before anything else: a win-* RuntimeIdentifier (or a build on a
       Windows host with no explicit RID) gets the full Windows app; a linux-* RID (or any other
       RID, or a build on a non-Windows host) gets the portable net10.0 target, which compiles only
       the platform-neutral sources behind the IPlatformBackend shell. Exactly one of WINDOWS /
       LINUX is defined and PlatformFactory switches on it. -->
  <PropertyGroup>
    <IsWindowsTarget Condition="'$(IsWindowsTarget)' == '' and '$(RuntimeIdentifier)' != ''">$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))</IsWindowsTarget>
    <IsWindowsTarget Condition="'$(IsWindowsTarget)' == '' and '$(RuntimeIdentifier)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</IsWindowsTarget>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework Condition="'$(IsWindowsTarget)' == 'true'">net10.0-windows10.0.26100.0</TargetFramework>
    <TargetFramework Condition="'$(IsWindowsTarget)' != 'true'">net10.0</TargetFramework>
    <OutputType Condition="'$(IsWindowsTarget)' == 'true'">WinExe</OutputType>
    <OutputType Condition="'$(IsWindowsTarget)' != 'true'">Exe</OutputType>
    <!-- Only needed to cross-compile the Windows target off-Windows; harmless where it is true. -->
    <EnableWindowsTargeting Condition="'$(IsWindowsTarget)' == 'true'">true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Clippy</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <!-- The Windows app has always shipped win-x64; the portable target leaves the RID to the
         caller (-r linux-x64) so it can run anywhere dotnet can. -->
    <RuntimeIdentifier Condition="'$(IsWindowsTarget)' == 'true'">win-x64</RuntimeIdentifier>
    <!-- Reflection-based JSON and any other trimmed-away metadata should fail the build loudly in
         CI rather than throwing at runtime on a user's machine. -->
    <TrimMode>partial</TrimMode>
    <DefineConstants Condition="'$(IsWindowsTarget)' == 'true'">$(DefineConstants);WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(IsWindowsTarget)' != 'true'">$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <!-- The icon for the executable, and the source for the taskbar, the Alt-Tab entry and the tray:
       TrayIcon reads it back out of this binary with ExtractIconExW, so all four show the same
       thing. It has to be a real size set, not one image: the tray needs the 16x16 drawn verbatim
       rather than a 128x128 scaled down. -->
  <PropertyGroup Condition="'$(IsWindowsTarget)' == 'true'">
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectX" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="Vortice.Win32.Graphics.Imaging" Version="2.5.0" />
  </ItemGroup>

  <!-- On the portable target the Windows capture, encoder and UI stack is not compiled at all:
       the sources stay on disk untouched, they just do not take part in the build. The Windows
       backend is excluded for the same reason in reverse: it is the only file that may reach
       those classes. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Capture\ScreenCapture.cs" />
    <Compile Remove="Capture\AudioCapture.cs" />
    <Compile Remove="Encoders\MfAudioEncoder.cs" />
    <Compile Remove="Encoders\MfVideoEncoder.cs" />
    <Compile Remove="Encoders\NvencDirectVideoEncoder.cs" />
    <Compile Remove="Encoders\NvencNative.cs" />
    <Compile Remove="UI\TrayIcon.cs" />
    <Compile Remove="UI\OverlayNotification.cs" />
    <Compile Remove="UI\HotkeyService.cs" />
    <Compile Remove="UI\FolderPicker.cs" />
    <Compile Remove="UI\ExportNotification.cs" />
    <Compile Remove="Tests\MfAudioPrototype.cs" />
    <Compile Remove="Tests\MfVideoPrototype.cs" />
    <Compile Remove="Tests\SmokeTest.cs" />
    <Compile Remove="Platform\WindowsPlatformBackend.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="Platform\LinuxPlatformBackend.cs" />
    <Compile Remove="Platform\LinuxDbus.cs" />
    <Compile Remove="Platform\LinuxPortal.cs" />
    <Compile Remove="Platform\LinuxVideoPipeline.cs" />
    <Compile Remove="Platform\LinuxAudioPipeline.cs" />
    <Compile Remove="Platform\LinuxNotifications.cs" />
    <Compile Remove="Platform\LinuxHotkeyService.cs" />
    <Compile Remove="Platform\LinuxDesktopIntegration.cs" />
    <Compile Remove="Platform\LinuxTrayIcon.cs" />
  </ItemGroup>

  <!-- The default notification sound, compiled INTO the exe so a portable install ships one file
       and an empty CustomSoundPath still plays something. LogicalName pins the manifest name to
       DefaultSound.wav (no namespace prefix); that string is hard-coded in
       ExportNotification.LoadEmbeddedSound, so renaming either side silently degrades to
       MessageBeep, and the "embedded default sound" smoke check is what catches it. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\sounds\sound.wav" LogicalName="DefaultSound.wav" />
    <!-- The tray pixmap and the Linux hicolor icon come from the same app.ico the Windows
         build uses for its executable: LinuxIconAssets extracts its frames at runtime. -->
    <EmbeddedResource Include="assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <!-- A portable folder: ffmpeg.exe dropped next to the binary is used in preference to PATH, and
       both the default config and the bundled tool travel with the published app. -->
  <ItemGroup>
    <None Include="ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('ffmpeg.exe')" />
    <None Include="..\config.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- A real capture, committed deliberately. Mp4WriterSelfTest parses REAL SPS/PPS and compares
         real PTS against ffprobe; invented codec parameters would not exercise the paths that matter.
         Without this copied, the mp4 test fails on a published binary with FileNotFoundException. -->
    <None Include="Tests\mp4-selftest-frames.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Tests\mp4-selftest-audio.aac" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
<!-- The HEVC counterpart of the fixture above: a real VPS/SPS/PPS and twelve real pictures from
         libx265. Synthetic parameter sets were tried first and ffprobe refused the resulting track,
         because it parses the SPS out of hvcC before it will name a stream, so this container test
         needs the real thing for the same reason the H.264 one does. -->
    <None Include="Tests\mp4-selftest-hevc.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The native NVENC bridge, built by src\native\build.cmd. -->
  <!-- CopyToPublishDirectory on a None item does not carry a file from a nested folder into the -->
  <!-- publish directory here, so a target copies it instead. It must sit next to Clippy.exe: the -->
  <!-- P/Invoke name is bare and is resolved against the application directory. The encoder treats a -->
  <!-- missing DLL as "no hardware encoder on this machine" and falls back to ffmpeg, so a build -->
  <!-- machine without MSVC still produces a working binary. -->
  <Target Name="CopyNvencBridge" AfterTargets="Build;Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\native\clippy_nvenc.dll"
          DestinationFolder="$(OutDir)"
          Condition="Exists('$(MSBuildProjectDirectory)\native\clippy_nvenc.dll') AND '$(OutDir)' != ''" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\native\clippy_nvenc.dll"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('$(MSBuildProjectDirectory)\native\clippy_nvenc.dll') AND '$(PublishDir)' != ''" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Tests\mp4-selftest-frames.bin;$(MSBuildProjectDirectory)\Tests\mp4-selftest-audio.aac;$(MSBuildProjectDirectory)\Tests\mp4-selftest-hevc.bin"
          DestinationFolder="$(OutDir)"
          Condition="'$(OutDir)' != ''" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Tests\mp4-selftest-frames.bin;$(MSBuildProjectDirectory)\Tests\mp4-selftest-audio.aac;$(MSBuildProjectDirectory)\Tests\mp4-selftest-hevc.bin"
          DestinationFolder="$(PublishDir)"
          Condition="'$(PublishDir)' != ''" />
  </Target>

</Project>
