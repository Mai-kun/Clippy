{
  // Папка с готовыми клипами. Считается относительно папки с Clippy.exe, а не относительно
  // текущего рабочего каталога, поэтому клипы всегда падают в одно место.
  "OutputFolder": "clips",

  // Папка для отладочных файлов: логи ffmpeg, таблицы таймингов, события. Отделена от клипов,
  // чтобы в папке с видео лежали только видео. При запуске старые логи зачищаются,
  // остаются только 10 самых свежих.
  "LogsFolder": "logs",

  // Длительность клипа по F9, в секундах. Сколько секунд из кольцевого буфера будет записано.
  "ShortClipSeconds": 30,

  // Длительность клипа по F10, в секундах. Тот же буфер, просто более длинный отрезок.
  "LongClipSeconds": 180,

  // Клавиша короткого клипа. Поддерживаются F1-F24.
  "ShortClipHotkey": "F9",

  // Клавиша длинного клипа.
  "LongClipHotkey": "F10",

  // Проигрывать короткий звук после сохранения клипа. Системное уведомление Windows
  // показывается независимо от этой настройки.
  "PlaySoundNotification": true,

  // Запускаться сразу свёрнутым в трей (без окна консоли). По умолчанию false:
  // при первом запуске лог в консоли — единственное, что видно, и исчезновение процесса
  // в трей трудно отличить от падения при старте. Включите, когда убедитесь, что всё работает.
  "StartMinimizedToTray": false,

  // Проверять наличие новых версий при запуске (один запрос к GitHub, который молча
  // игнорируется без интернета). Если версия найдена, придёт системное уведомление;
  // установка запускается вручную: правый клик по иконке в трее -> Check for Updates.
  "CheckForUpdates": true,

  // Видеокодек. Это предпочтение, а не требование: если выбранный кодировщик на этой машине
  // не работает, Clippy один раз напишет об этом в лог и продолжит запись через libx264.
  //
  //   "nvenc_direct" — прямой NVENC через нативный мостик clippy_nvenc.dll. Кадр отдаётся
  //       кодировщику прямо в VRAM, без копирования в системную память, и не запускается
  //       ни одного процесса ffmpeg. Требует видеокарту NVIDIA и саму DLL рядом с Clippy.exe.
  //   "h264_nvenc"  — тот же NVENC, но через дочерний процесс ffmpeg: кадр читается в ОЗУ
  //       и уходит в stdin. Проще в отладке, работает там, где нет DLL. Дефолт.
  //   "h264_qsv"    — Intel.   "h264_amf" — AMD.
  //   "libx264"     — программный кодировщик, качество задаёт CRF, а не битрейт. Любая
  //       видеокарта, в том числе без аппаратного кодирования; нагружает процессор.
  "VideoEncoder": "h264_nvenc",

  // Битрейт видео в Мбит/с для аппаратного кодировщика (NVENC). Кольцевой буфер хранит
  // уже закодированный поток, поэтому память растёт почти пропорционально битрейту.
  // Допустимый диапазон 2-50. На программном libx264 эта настройка не действует:
  // там качество задаёт CRF, а не целевой битрейт.
  //
  // Учтите: nvenc_direct задаёт битрейт как ЦЕЛЬ, а не как потолок. На насыщенном рабочем
  // столе 1080p фактический поток выходит выше заданного — замер на 20 секундах дал
  // 8.3 Мбит/с при запросе 6. Кольцо за 190 секунд при 10 Мбит/с — это примерно 240 МБ.
  "VideoBitrateMbps": 6,

  // Аудиокодек. "media_foundation" (по умолчанию) кодирует системный звук средствами Windows
  // (AAC в ADTS) прямо в процессе Clippy: ffmpeg для звука не нужен вообще. "ffmpeg" оставляет
  // старый путь — отдельный процесс ffmpeg, отдельный пайп, ~245 мс задержки, которые приходилось
  // вычитать из таймлайна. Значение это предпочтение, а не требование: если Media Foundation на
  // машине недоступен (нет подходящего MFT, устройство не 48 кГц), Clippy один раз напишет об этом
  // в лог и продолжит запись звука через ffmpeg.
  "AudioEncoder": "media_foundation",
}
