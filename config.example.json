{
  // Папка с готовыми клипами. Считается относительно папки с Clippy.exe, а не относительно
  // текущего рабочего каталога, поэтому клипы всегда падают в одно место.
  "OutputFolder": "clips",

  // Папка для отладочных файлов: логи ffmpeg, таблицы таймингов, события. Отделена от клипов,
  // чтобы в папке с видео лежали только видео. При запуске старые логи зачищаются,
  // остаются только 10 самых свежих.
  "LogsFolder": "logs",

  // Длительность клипа по F8, в секундах. Сколько секунд из кольцевого буфера будет записано.
  "ShortClipSeconds": 30,

  // Длительность клипа по F9, в секундах. Тот же буфер, просто более длинный отрезок.
  "LongClipSeconds": 180,

  // Клавиша короткого клипа (30 секунд). Поддерживаются F1-F24. По умолчанию F8.
  "ShortClipHotkey": "F8",

  // Клавиша длинного клипа (3 минуты). По умолчанию F9.
  "LongClipHotkey": "F9",

  // Проигрывать короткий звук после сохранения клипа. Системное уведомление Windows
  // показывается независимо от этой настройки.
  "PlaySoundNotification": true,

  // Путь к собственному звуку уведомления (.wav). Оставьте пустым, чтобы играл звук, встроенный
  // в Clippy.exe. Относительный путь считается от папки с Clippy.exe; если файл не найден,
  // всё равно играет встроенный звук.
  "CustomSoundPath": "",

  // Стиль визуального уведомления о сохранении клипа:
  //   "overlay"       — компактная тёмная плашка в стиле Medal / ShadowPlay в правом верхнем углу
  //                     экрана. Не перехватывает фокус и не ловит клики, поэтому не мешает игре
  //                     и не отвлекает во время матча. Плавно проявляется, висит ~2.6 с и тает.
  //                     По умолчанию.
  //   "windows_toast" — обычный системный тост Windows (без звука колокольчика, чтобы не мешать
  //                     встроенному звуку Clippy).
  //   "none"          — без визуального окна вообще; только звук (если PlaySoundNotification = true).
  // Переключается и в трее: Notifications -> Game Overlay / Windows Toast / Sound Only.
  // Неизвестное значение молча трактуется как "overlay".
  "NotificationType": "overlay",

  // Запускаться сразу свёрнутым в трей (без окна консоли). По умолчанию false:
  // при первом запуске лог в консоли — единственное, что видно, и исчезновение процесса
  // в трей трудно отличить от падения при старте. Включите, когда убедитесь, что всё работает.
  "StartMinimizedToTray": false,

  // Проверять наличие новых версий при запуске (один запрос к GitHub, который молча
  // игнорируется без интернета). Если версия найдена, придёт системное уведомление;
  // установка запускается вручную: правый клик по иконке в трее -> Check for Updates.
  "CheckForUpdates": true,

  // Видеокодек. Это предпочтение, а не требование: если выбранный кодировщик на этой машине
  // не работает, Clippy один раз напишет об этом в лог и продолжит запись через libx264.
  //
  //   "nvenc_direct" — прямой NVENC через нативный мостик clippy_nvenc.dll. Кадр отдаётся
  //       кодировщику прямо в VRAM, без копирования в системную память, и не запускается
  //       ни одного процесса ffmpeg. Требует видеокарту NVIDIA и саму DLL рядом с Clippy.exe.
  //   "h264_nvenc"  — тот же NVENC, но через дочерний процесс ffmpeg: кадр читается в ОЗУ
  //       и уходит в stdin. Проще в отладке, работает там, где нет DLL. Сюда Clippy//       откатывается сам, если nvenc_direct недоступен.
  //   "h264_qsv"    — Intel.   "h264_amf" — AMD.
  //   "libx264"     — программный кодировщик, качество задаёт CRF, а не битрейт. Любая
  //       видеокарта, в том числе без аппаратного кодирования; нагружает процессор.
  "VideoEncoder": "nvenc_direct",

  // Кодек видео: "hevc" (H.265, по умолчанию) или "h264".
  //
  // Учитывается только прямым мостиком NVENC (VideoEncoder = "nvenc_direct") — это единственный
  // путь, который говорит с кодировщиком без промежуточного процесса ffmpeg и может попросить у
  // драйвера NV_ENC_CODEC_HEVC_GUID. Кодировщики через ffmpeg всегда дают H.264, и муксер смотрит
  // на сами байты, а не на эту настройку: файл пишется как hvc1 только тогда, когда кодировщик
  // действительно отдал VPS. Поэтому откат на ffmpeg даст корректный H.264-клип, а не битый HEVC.
  //
  // Зачем: HEVC даёт примерно вдвое больше деталей на бит. Та же картинка укладывается примерно
  // вдвое в меньший битрейт — на 3 Мбит/с HEVC соответствует тому, что H.264 требовал на 6.
  // Значит RAM-голова (32 с) и трёхминутный клип при том же качестве становятся вдвое меньше.
  // Требуется видеокарта, у которой NVENC умеет H.265; иначе будет откат на H.264 с записью в лог.
  "VideoCodec": "hevc",

  // Битрейт видео в Мбит/с для аппаратного кодировщика (NVENC). Кольцевой буфер хранит
  // уже закодированный поток, поэтому память растёт почти пропорционально битрейту.
  // Допустимый диапазон 2-50. На программном libx264 эта настройка не действует:
  // там качество задаёт CRF, а не целевой битрейт.
  //
  // Учтите: nvenc_direct задаёт битрейт как ЦЕЛЬ, а не как потолок. На насыщенном рабочем
  // столе 1080p фактический поток выходит выше заданного — замер на 20 секундах дал
  // 8.3 Мбит/с при запросе 6. Кольцо за 190 секунд при 10 Мбит/с — это примерно 240 МБ.
  "VideoBitrateMbps": 6,

  // Потолок на размер папки с клипами, в гигабайтах. 0 = без ограничений.
  // Когда значение больше нуля, после каждого сохранения (и при запуске) самые старые
  // клипы удаляются, пока папка не уложится в квоту. Считаются и удаляются только *.mp4:
  // в папке могут лежать ваши собственные файлы, и молча удалять их ради квоты видео
  // недопустимо. Допустимые значения: 0, 10, 20, 30, 50. Любое другое молча трактуется
  // как 0, то есть «без ограничения»: опечатка не должна приводить к удалению файлов.
  // То же самое настраивается в трее: Clips Storage Limit.
  "MaxClipsFolderSizeGB": 0,

  // Аудиокодек. "media_foundation" (по умолчанию) кодирует системный звук средствами Windows
  // (AAC в ADTS) прямо в процессе Clippy: ffmpeg для звука не нужен вообще. "ffmpeg" оставляет
  // старый путь — отдельный процесс ffmpeg, отдельный пайп, ~245 мс задержки, которые приходилось
  // вычитать из таймлайна. Значение это предпочтение, а не требование: если Media Foundation на
  // машине недоступен (нет подходящего MFT, устройство не 48 кГц), Clippy один раз напишет об этом
  // в лог и продолжит запись звука через ffmpeg.
  "AudioEncoder": "media_foundation",
}
